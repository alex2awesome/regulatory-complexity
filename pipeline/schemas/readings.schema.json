{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReadingEnsembleResponses",
  "description": "Decisions of an ensemble of readers applying one judgment predicate to a sweep of latent-world cases. Consumed by looseness.py (measure). Readers may be LLM instantiations, humans, or city checklists — the source is recorded because ensemble coverage OF HUMAN READINGS is the instrument's key validity check.",
  "type": "object",
  "required": ["world_id", "readers", "responses"],
  "properties": {
    "world_id": { "type": "string" },
    "predicate_text": { "type": "string" },
    "readers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reader_id", "source"],
        "properties": {
          "reader_id": { "type": "string" },
          "source": { "enum": ["llm", "human", "checklist"] },
          "detail": { "type": "string", "description": "Model+persona, annotator role, or jurisdiction." }
        }
      }
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reader_id", "case_id", "theta", "decision"],
        "properties": {
          "reader_id": { "type": "string" },
          "case_id": { "type": "string" },
          "theta": { "type": "object", "additionalProperties": { "type": "number" } },
          "decision": { "type": "boolean", "description": "True iff the reader finds the predicate SATISFIED (e.g. 'inadequate sanitation' present)." },
          "rationale": { "type": "string" }
        }
      }
    }
  }
}
